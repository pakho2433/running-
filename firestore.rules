rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStudent() {
      return profileExists()
        && profile().role == "student"
        && profile().active == true
        && profile().classId is string
        && profile().studentId is string
        && profile().schoolYear == "2026-2027";
    }

    function isTeacher() {
      return profileExists()
        && request.auth.token.teacher == true
        && request.auth.token.role == "teacher"
        && request.auth.token.schoolYear == "2026-2027"
        && profile().role == "teacher"
        && profile().active == true
        && profile().schoolYear == "2026-2027";
    }

    function myStudentKey() {
      return "2026-2027__" + request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /students/{studentKey} {
      allow read: if (isTeacher() && resource.data.schoolYear == "2026-2027")
        || (isStudent()
          && studentKey == myStudentKey()
          && resource.data.authUid == request.auth.uid
          && resource.data.schoolYear == "2026-2027");
      allow create, update, delete: if false;
    }

    match /publicStudents/{studentKey} {
      allow read: if (isTeacher() && resource.data.schoolYear == "2026-2027")
        || (isStudent()
          && resource.data.schoolYear == "2026-2027"
          && resource.data.classId == profile().classId
          && resource.data.keys().hasOnly([
            "schoolYear", "classId", "displayAlias", "booksCount", "distance", "updatedAt"
          ]));
      allow create, update, delete: if false;
    }

    match /bookLogs/{logId} {
      allow read: if (isTeacher() && resource.data.schoolYear == "2026-2027")
        || (isStudent()
          && resource.data.schoolYear == "2026-2027"
          && resource.data.authUid == request.auth.uid
          && resource.data.studentKey == myStudentKey());
      allow create, update, delete: if false;
    }

    match /dailyRecommendations/{dateKey} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
